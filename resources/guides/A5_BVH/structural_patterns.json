{
  "version": "1.0",
  "dataset": "BVH_BCTC_2025_hop_nhat_kiem_toan(1).md",
  "scope_note": "Bộ pattern xây riêng từ BVH; không merge với ngân hàng/doanh nghiệp khác.",
  "sample_definition": "Structural sample gồm bullet node trong Content và Markdown table data row. Metadata không tính. Một root bullet chỉ là số trang được loại noise.",
  "patterns": [
    {
      "id": "P010",
      "name": "qualifier_container",
      "priority": 150,
      "description": "Qualifier-only node như Trong đó:.",
      "detect": {
        "required": [
          "bullet",
          "whole_text_matches_qualifier",
          "no_value"
        ]
      },
      "semantic_fields": [
        "qualifier",
        "children"
      ],
      "extract": {
        "qualifier": "Bỏ dấu : cuối.",
        "children": "Theo indentation subtree."
      },
      "examples": [
        "Trong đó:"
      ]
    },
    {
      "id": "P006",
      "name": "markdown_table_row",
      "priority": 145,
      "description": "Data row trong Markdown table có header/separator rõ.",
      "detect": {
        "required": [
          "table_context",
          "not_separator_row"
        ]
      },
      "semantic_fields": [
        "label",
        "note",
        "values.raw_value",
        "values.period",
        "values.unit"
      ],
      "extract": {
        "schema": "Từ header gần nhất.",
        "label": "Cột chỉ tiêu/text.",
        "note": "Cột Thuyết minh nếu có.",
        "values": "Mỗi numeric cell gắn period/unit theo header."
      },
      "examples": [
        "| 110 | I. Tiền và các khoản tương đương tiền | 5 | 4.194.682.648.364 | 1.464.088.127.113 |"
      ]
    },
    {
      "id": "P008",
      "name": "pipe_delimited_inline_row",
      "priority": 140,
      "description": "Bullet/non-table line có nhiều segment phân tách bằng | nhưng không có table context.",
      "detect": {
        "required": [
          "contains_pipe",
          "multiple_segments"
        ],
        "exclude": [
          "table_context"
        ]
      },
      "semantic_fields": [
        "label",
        "values.raw_value",
        "values.role"
      ],
      "extract": {
        "label": "Text trước region dữ liệu.",
        "segments": "Split theo |.",
        "values": "Giữ raw value và role/column text nếu explicit."
      }
    },
    {
      "id": "P002",
      "name": "period_container",
      "priority": 135,
      "description": "Node chỉ biểu diễn kỳ và truyền period context cho child.",
      "detect": {
        "required": [
          "bullet",
          "whole_text_is_period"
        ]
      },
      "semantic_fields": [
        "values.period",
        "values.unit",
        "children"
      ],
      "extract": {
        "period": "Giữ raw period text.",
        "unit": "Unit parenthetical nếu có.",
        "children": "Propagate vào subtree."
      },
      "examples": [
        "Cho năm tài chính kết thúc ngày 31 tháng 12 năm 2025",
        "Ngày 31 tháng 12 năm 2025 (VND)"
      ]
    },
    {
      "id": "P005",
      "name": "label_multi_period_inline",
      "priority": 130,
      "description": "Label chứa từ hai value-period pair explicit trên cùng node.",
      "detect": {
        "required": [
          "label",
          "value_count>=2",
          "period_count>=2"
        ],
        "warning": "Phải loại date/legal prose; chỉ nhận khi pairing value-period rõ hoặc có unit/segment delimiter."
      },
      "semantic_fields": [
        "label",
        "values.raw_value",
        "values.period",
        "values.unit"
      ],
      "extract": {
        "values": "Pair value-period trong cùng clause; không ghép xuyên clause mơ hồ."
      }
    },
    {
      "id": "P007",
      "name": "named_attribute",
      "priority": 120,
      "description": "Structural key:value như Mã số, Thuyết minh, Số tiền, Tên công ty, Tỷ lệ sở hữu.",
      "detect": {
        "required": [
          "bullet",
          "lhs_in_attribute_lexicon"
        ]
      },
      "semantic_fields": [
        "note",
        "children"
      ],
      "extract": {
        "attribute_key": "Giữ key.",
        "attribute_value": "Giữ rhs.",
        "note": "Chỉ Thuyết minh map trực tiếp sang canonical note."
      },
      "examples": [
        "Mã số: 210",
        "Thuyết minh: 6.2",
        "Số tiền: 2.705.805.497.909"
      ]
    },
    {
      "id": "P003",
      "name": "period_value_attribute",
      "priority": 110,
      "description": "Period ở lhs và value ở rhs.",
      "detect": {
        "required": [
          "bullet",
          "starts_with_period",
          "has_colon",
          "rhs_has_value"
        ]
      },
      "semantic_fields": [
        "values.raw_value",
        "values.period",
        "values.unit",
        "values.role"
      ],
      "extract": {
        "period": "lhs period text.",
        "raw_value": "Token value đầu tiên rhs, giữ raw.",
        "unit": "Unit explicit nếu có."
      },
      "examples": [
        "Ngày 31 tháng 12 năm 2025: 141.442.600.516.098",
        "Năm tài chính kết thúc ngày 31 tháng 12 năm 2024: 2.663.171.477.296"
      ]
    },
    {
      "id": "P004",
      "name": "label_value_inline",
      "priority": 70,
      "description": "Generic label:value có numeric/value token, sau khi loại pattern cụ thể hơn.",
      "detect": {
        "required": [
          "bullet",
          "has_colon",
          "rhs_has_value"
        ],
        "exclude": [
          "P002",
          "P003",
          "P005",
          "P007",
          "P008",
          "P010"
        ]
      },
      "semantic_fields": [
        "label",
        "note",
        "values.raw_value",
        "values.period",
        "values.unit"
      ],
      "extract": {
        "label": "lhs trước colon.",
        "raw_value": "Value trong rhs; không coi mọi số trong câu là financial value.",
        "period": "Explicit hoặc inherited từ P002."
      }
    },
    {
      "id": "P001",
      "name": "label_or_container",
      "priority": 20,
      "description": "Fallback structural bullet text/container.",
      "detect": {
        "required": [
          "bullet",
          "non_empty_text"
        ],
        "exclude": [
          "specific_patterns",
          "root_page_number_noise"
        ]
      },
      "semantic_fields": [
        "label",
        "children"
      ],
      "extract": {
        "label": "Bỏ bullet marker/Markdown emphasis.",
        "children": "Theo hierarchy rules."
      }
    }
  ],
  "selection_order": [
    "P010",
    "P006",
    "P008",
    "P002",
    "P005",
    "P007",
    "P003",
    "P004",
    "P001"
  ]
}
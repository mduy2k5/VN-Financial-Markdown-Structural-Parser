{
  "contract_id": "OFF_BALANCE_ALIAS_NORMALIZATION_V1",
  "version": "1.0.0",
  "purpose": "Normalize presentation-only variation before semantic alias matching; do not change financial meaning.",
  "ordered_rules": [
    {
      "id": "strip_markdown_table",
      "action": "extract_first_text_cell",
      "examples": [
        "| Bảo lãnh vay vốn | 6.502.759 | 3.658.967 | -> Bảo lãnh vay vốn"
      ]
    },
    {
      "id": "strip_stt_prefix",
      "pattern": "^\\\\s*STT\\\\s*:\\\\s*(?:\\\\d+\\\\.?\\\\s*)?",
      "replacement": "",
      "examples": [
        "STT: 1. Bảo lãnh vay vốn -> Bảo lãnh vay vốn",
        "STT: Tổng cộng -> Tổng cộng"
      ]
    },
    {
      "id": "strip_enum_prefix",
      "pattern": "^\\\\s*(?:\\\\d+|[a-zA-Z])\\\\s*[.):-]\\\\s*",
      "replacement": "",
      "examples": [
        "a. Cam kết mua ngoại tệ -> Cam kết mua ngoại tệ",
        "2. Cam kết bán ngoại tệ -> Cam kết bán ngoại tệ"
      ]
    },
    {
      "id": "strip_bare_numeric_prefix",
      "pattern": "^\\\\s*\\\\d+\\\\s+(?=[A-Za-zÀ-ỹ])",
      "replacement": "",
      "examples": [
        "2 Cam kết bán ngoại tệ -> Cam kết bán ngoại tệ"
      ]
    },
    {
      "id": "extract_note_suffix",
      "pattern": "\\\\s*\\\\((?:Thuyết minh|TM)\\\\s*:\\\\s*[^)]*\\\\)\\\\s*$",
      "replacement": "",
      "capture_as": "note_ref",
      "examples": [
        "Nợ khó đòi đã xử lý (Thuyết minh: 36) -> Nợ khó đòi đã xử lý"
      ]
    },
    {
      "id": "strip_inline_payload_colon",
      "pattern": "\\\\s*:\\\\s*[-(]?\\\\d[\\\\d.,\\\\s)]*(?:\\\\s*(?:triệu|nghìn|tỷ)?\\\\s*(?:VND|đồng))?(?:.*)$",
      "replacement": "",
      "guard": "only_when_prefix_before_colon_contains_letters",
      "examples": [
        "Bảo lãnh vay vốn: 5.884.776 -> Bảo lãnh vay vốn"
      ]
    },
    {
      "id": "strip_inline_payload_year_pair",
      "pattern": "\\\\s*:\\\\s*.*\\\\(năm\\\\s+20\\\\d{2}\\\\).*",
      "replacement": "",
      "guard": "only_when_prefix_before_colon_contains_letters"
    },
    {
      "id": "collapse_whitespace",
      "action": "collapse_whitespace"
    },
    {
      "id": "unicode_casefold_for_lookup",
      "action": "casefold_and_remove_diacritics",
      "note": "Lookup normalization only; preserve original source label in output."
    }
  ],
  "never_semantic_alias_patterns": [
    "^(?:VIII|VII|VI|V|IV|III|II|I)\\\\.\\\\d+(?:\\\\.\\\\d+)*$",
    "^Thuyết minh(?:\\\\s*:\\\\s*.+)?$",
    "^\\\\d{1,2}/\\\\d{1,2}/20\\\\d{2}",
    "^Mã hiệu\\\\s*:",
    "^Địa điểm\\\\s*:"
  ],
  "policy": "If normalization removes all text or produces a note reference / metadata token, return NOT_ALIAS rather than fuzzy-match."
}